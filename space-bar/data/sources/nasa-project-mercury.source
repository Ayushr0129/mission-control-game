											<figure class="hds-media-background "><img decoding="async" width="1423" height="1920" src="https://images-assets.nasa.gov/image/LRC-1959-B701_P-02365/LRC-1959-B701_P-02365~large.jpg?w=1423&amp;h=1920&amp;fit=clip&amp;crop=faces%2Cfocalpoint" class="attachment-thumbnail size-thumbnail" alt="" style="transform: scale(1.2); transform-origin: 52% 28%; object-position: 52% 28%; object-fit: cover;" block_context="nasa-block" loading="lazy" srcset="https://images-assets.nasa.gov/image/LRC-1959-B701_P-02365/LRC-1959-B701_P-02365~large.jpg?w=1423&amp;h=1920&amp;fit=crop&amp;crop=faces%2Cfocalpoint 1423w, https://images-assets.nasa.gov/image/LRC-1959-B701_P-02365/LRC-1959-B701_P-02365~large.jpg?w=222&amp;h=300&amp;fit=crop&amp;crop=faces%2Cfocalpoint 222w, https://images-assets.nasa.gov/image/LRC-1959-B701_P-02365/LRC-1959-B701_P-02365~large.jpg?w=768&amp;h=1036&amp;fit=crop&amp;crop=faces%2Cfocalpoint 768w, https://images-assets.nasa.gov/image/LRC-1959-B701_P-02365/LRC-1959-B701_P-02365~large.jpg?w=759&amp;h=1024&amp;fit=crop&amp;crop=faces%2Cfocalpoint 759w, https://images-assets.nasa.gov/image/LRC-1959-B701_P-02365/LRC-1959-B701_P-02365~large.jpg?w=1138&amp;h=1535&amp;fit=crop&amp;crop=faces%2Cfocalpoint 1138w, https://images-assets.nasa.gov/image/LRC-1959-B701_P-02365/LRC-1959-B701_P-02365~large.jpg?w=296&amp;h=399&amp;fit=crop&amp;crop=faces%2Cfocalpoint 296w, https://images-assets.nasa.gov/image/LRC-1959-B701_P-02365/LRC-1959-B701_P-02365~large.jpg?w=445&amp;h=600&amp;fit=crop&amp;crop=faces%2Cfocalpoint 445w, https://images-assets.nasa.gov/image/LRC-1959-B701_P-02365/LRC-1959-B701_P-02365~large.jpg?w=667&amp;h=900&amp;fit=crop&amp;crop=faces%2Cfocalpoint 667w, https://images-assets.nasa.gov/image/LRC-1959-B701_P-02365/LRC-1959-B701_P-02365~large.jpg?w=889&amp;h=1199&amp;fit=crop&amp;crop=faces%2Cfocalpoint 889w" sizes="auto, (max-width: 1423px) 100vw, 1423px" /></figure>										</div>
									</a>
																<div class="hds-meet-the-content">
									 
										<a href="https://www.nasa.gov/former-astronaut-donald-k-deke-slayton/" target="_self"  class="display-block margin-bottom-1">
											<h3 class="heading-18 color-spacesuit-white link-underline-dashed-light border-carbon-30 margin-0 display-inline-block">Donald K. &quot;Deke&quot; Slayton</h3>
										</a>
																		<p class="line-height-md color-carbon-40 margin-0 padding-0 p-sm">Apollo-Soyuz Test Project astronaut</p>
									<div class="meet-the-icons">
																																<a href="https://www.nasa.gov/apollo-soyuz-test-project/" class="meet-the-icon" tabindex="-1" aria-label="Go to Apollo-Soyuz Test Project">
												<div class="hds-media-inner hds-custom-fit-cover">
													<div class="hds-media-wrapper margin-left-auto margin-right-auto"><figure class="hds-media-inner hds-cover-wrapper hds-media-ratio-cover "><img decoding="async" width="150" height="150" src="https://www.nasa.gov/wp-content/uploads/2020/07/astp_crew_patch_s75-20361.jpg?w=150&amp;h=150&amp;crop=1" class="attachment-thumbnail size-thumbnail" alt="Go to Apollo-Soyuz Test Project" style="transform: scale(1); transform-origin: 50% 50%; object-position: 50% 50%; object-fit: cover;" block_context="nasa-block" loading="lazy" aria-hidden="true" srcset="https://www.nasa.gov/wp-content/uploads/2020/07/astp_crew_patch_s75-20361.jpg 985w, https://www.nasa.gov/wp-content/uploads/2020/07/astp_crew_patch_s75-20361.jpg?resize=150,150 150w, https://www.nasa.gov/wp-content/uploads/2020/07/astp_crew_patch_s75-20361.jpg?resize=300,300 300w, https://www.nasa.gov/wp-content/uploads/2020/07/astp_crew_patch_s75-20361.jpg?resize=768,765 768w, https://www.nasa.gov/wp-content/uploads/2020/07/astp_crew_patch_s75-20361.jpg?resize=50,50 50w, https://www.nasa.gov/wp-content/uploads/2020/07/astp_crew_patch_s75-20361.jpg?resize=100,100 100w, https://www.nasa.gov/wp-content/uploads/2020/07/astp_crew_patch_s75-20361.jpg?resize=200,200 200w, https://www.nasa.gov/wp-content/uploads/2020/07/astp_crew_patch_s75-20361.jpg?resize=400,398 400w, https://www.nasa.gov/wp-content/uploads/2020/07/astp_crew_patch_s75-20361.jpg?resize=600,598 600w, https://www.nasa.gov/wp-content/uploads/2020/07/astp_crew_patch_s75-20361.jpg?resize=900,896 900w" sizes="auto, (max-width: 150px) 100vw, 150px" /></figure></div>												</div>
											</a>
																																							</div>
								</div>
							</div>
						</div>
									</div>
				<div class="hds-carousel-nav hds-carousel-nav-next display-flex margin-right-auto margin-left-0">
