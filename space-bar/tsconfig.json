{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": false, "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client"],
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true
  },
  "include": ["src", "tests"]
}
